# Maintainer: dragonruler1000 <github@me.minecraftchest2.us>

pkgname=wlpipes
# Keep in step with .version in build.zig.zon, and tag the release to match.
pkgver=0.1.3
pkgrel=1
pkgdesc="The Windows 95 3D Pipes screensaver, as a native Wayland client"
arch=('x86_64')
url="https://github.com/dragonruler1000/wlpipes"
license=('MIT')
depends=('wayland' 'libglvnd')
makedepends=('git' 'zig>=0.17.0' 'wayland-protocols' 'pkgconf')
optdepends=('hypridle: run the screensaver after an idle timeout'
            'hyprlock: lock the session once the screensaver has been running')
options=('!debug')

# Pinned to the release tag rather than a branch, so a given pkgver always
# builds the same source. SKIP is the norm for a git source: the tag is what
# fixes the revision, not a checksum over a tarball GitHub regenerates.
source=("$pkgname::git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

prepare() {
	cd "$srcdir/$pkgname"

	# Zig resolves the zig-wayland dependency over the network. Doing it here
	# keeps build() offline, which is where makepkg expects the network to be
	# unavailable.
	zig build --fetch
}

build() {
	cd "$srcdir/$pkgname"

	# Keep every scrap of build state inside $srcdir so `makepkg -C` really
	# cleans and no build inherits another's cache.
	export ZIG_GLOBAL_CACHE_DIR="$srcdir/zig-global-cache"

	zig build \
		--release=fast \
		--cache-dir "$srcdir/zig-cache" \
		--prefix "$srcdir/out"
}

package() {
	cd "$srcdir/$pkgname"

	install -Dm755 "$srcdir/out/bin/wlpipes" "$pkgdir/usr/bin/wlpipes"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
	install -Dm644 packaging/wlpipes.1 "$pkgdir/usr/share/man/man1/wlpipes.1"
	install -Dm644 packaging/hypridle.conf.example \
		"$pkgdir/usr/share/doc/$pkgname/hypridle.conf.example"
}
